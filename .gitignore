# =========================================================================
#  Laravel + React (Vite) — Git Ignore — أفضل الممارسات
#  (يُتجاهل فقط ما يجب تجاهله دون المساس بملفات المصدر)
# =========================================================================

# -------------------------------------------------------------------------
#  ملفات البيئة المحلية (لا تُرفع أبداً؛ قد تحوي أسراراً)
#  لكن يبقى `.env.example` متضمّناً في المستودع.
# -------------------------------------------------------------------------
/.env
/.env.*
!/.env.example

# -------------------------------------------------------------------------
#  التبعيات / الحزم (يُعاد تثبيتها عبر composer / npm)
# -------------------------------------------------------------------------
/vendor
node_modules/

# -------------------------------------------------------------------------
#  مخرجات البناء (Build output)
# -------------------------------------------------------------------------
/frontend/dist
/frontend/node_modules
/public/build

# -------------------------------------------------------------------------
#  كاش Laravel وتطبيقات الاختبار
# -------------------------------------------------------------------------
/bootstrap/cache/*
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/storage/pail

# إبقاء ملفات الـ .gitignore الداخلية مضمّنةً مع بنية المجلدات
!/bootstrap/cache/.gitignore
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore

# -------------------------------------------------------------------------
#  ملفات PHPUnit / أدوات التطوير
# -------------------------------------------------------------------------
/.phpunit.result.cache
/.phpunit.cache
/.phpactor.json
/.php_cs.cache
.phpunit.result.cache
.phpunit.cache

# -------------------------------------------------------------------------
#  الاعتمادات المحلية / ملفات التصريح
# -------------------------------------------------------------------------
/auth.json

# -------------------------------------------------------------------------
#  بيئات التطوير / محررات الأكواد
# -------------------------------------------------------------------------
/.idea
/.vscode
/.fleet
/.nova
/.zed

# -------------------------------------------------------------------------
#  ملفات نظام التشغيل
# -------------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# -------------------------------------------------------------------------
#  ملفات السجلات العامة
# -------------------------------------------------------------------------
*.log


# -------------------------------------------------------------------------
#  Extra safety rules (added during repository cleanup)
#  Purpose: never re-upload secrets, dependencies, logs, cache or DB dumps.
# -------------------------------------------------------------------------

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
auth.json

# Dependencies (reinstalled via composer / npm)
/vendor/
vendor/
node_modules/
**/node_modules/

# Logs & cache
*.log
logs/
**/logs/
cache/
**/cache/
.bootstrap/cache/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/logs/
storage/pail

# Build output
/frontend/dist/
dist/
/public/build/

# Database dumps / dumps that may contain real data or tokens
*.sql
*.sqlite
*.sqlite3
*.dump
dump.sql

# Local / IDE / OS
.phpunit.result.cache
.phpunit.cache
.idea/
.vscode/
.DS_Store
Thumbs.db
